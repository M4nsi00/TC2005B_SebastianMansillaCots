        <div class="row g-4">
            <% for (let u of usuarios) { %>
                <div class="col-md-4">
                    <div class="card h-100 border-primary shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title text-primary"> ID: <%= u.id%></h5>
                            <p class="card-text"><strong>Usuario:</strong> <%= u.username%></p>
                        </div>
                        <div class="card-footer text-muted small">
                            Registrado el: <%= u.fecha_registro%>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
    <% console.log(usuarios) %>