<div class="row g-4">
    <% for (let u of usuarios) { %>
        <div class="col-md-4">
            <div class="card h-100 border-primary shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-primary"> ID: <%= u.id %></h5>
                    
                    <div class="d-flex align-items-center mt-3">
                        
                        <% if (u.fotoPerfil && u.fotoPerfil !== '') { %>
                            <img src="/uploads/<%= u.fotoPerfil %>" alt="Foto de <%= u.username %>" 
                                class="rounded-circle shadow-sm me-3" 
                                style="width: 50px; height: 50px; object-fit: cover;">
                        <% } else { %>
                            <div class="rounded-circle bg-secondary text-white d-flex justify-content-center align-items-center shadow-sm me-3" 
                                 style="width: 50px; height: 50px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                  <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H3Zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/>
                                </svg>
                            </div>
                        <% } %>

                        <p class="card-text mb-0"><strong>Usuario:</strong> <%= u.username %></p>
                    </div>
                    <button class="btn btn-danger btn-eliminar mt-3" data-id="<%= u.id %>">
                        Eliminar
                    </button>
                </div>
                <div class="card-footer text-muted small">
                    Registrado el: <%= u.fecha_registro %>
                </div>
            </div>
        </div>
    <% } %>
</div>
<% console.log(usuarios) %>