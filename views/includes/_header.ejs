<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laboratorios</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" 
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
        <style>
        #foto_perfil {
            width: 240px;
            height: 240px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #ffff;
        }
        .carousel-img-custom {
            width: 100%;
            height: 500px;
            object-fit: contain;
            padding: 10px;
        }
    </style>
    <meta name="csrf-token" content="<%= csrfToken %>">
</head>
<body>
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">Laboratorios</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                        <a class="nav-link active btn btn-primary" aria-current="page" href="/">Home</a>
                        </li>
                        <li class="nav-item">
                        <a class="nav-link active btn btn-info" href="/labs">Preguntas Laboratorios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active d-flex btn btn-light" href="/users/signup">Sign UP</a>
                        </li> <li class="nav-item">
                            <% if (typeof(username) != "undefined") { %>
                                <a class="nav-link active btn btn-danger" href="/users/logout"> Log OUT</a>
                            <% } else { %>
                                <a class="nav-link active btn btn-success" href="/users/login"> Log IN</a>
                            <% } %>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    <header class="py-5 border-bottom mb-5">
        <div class="container">
            <h1 class="display-2 fw-bold">Laboratorios</h1>
        </div>
    </header>
    